DB_HOST=db
DB_PORT=5432
DB_USERNAME=user
DB_PASSWORD=password
DB_DATABASE=aegis_db

# ==> Backend (NestJS API) Configuration
JWT_SECRET=your_super_strong_and_long_jwt_secret_key_here
OPENROUTESERVICE_API_KEY=your_openrouteservice_api_key_here

# ==> Frontend (Next.js App) Configuration
# The frontend container connects to the backend container using its service name ('backend')
NEXT_PUBLIC_API_BASE_URL=http://backend:3000
NEXT_PUBLIC_MAPTILER_API_KEY=your_maptiler_api_key_here