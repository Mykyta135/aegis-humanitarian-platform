# File: dyploma-backend/.env.example

# PostgreSQL Database Connection
DB_HOST=db
DB_PORT=5432
DB_USERNAME=user
DB_PASSWORD=password
DB_DATABASE=aegis_db

# JWT signing key — required, at least 32 random characters: openssl rand -hex 32
JWT_SECRET=

# Demo data loader (POST /seed). Creates admin accounts with known passwords:
# keep it off anywhere but a local demo.
ENABLE_SEED=false

# OpenRouteService API Key (Optional, for routing features)
OPENROUTESERVICE_API_KEY=your_api_key_here