# File: dyploma-backend/.env.example

# PostgreSQL Database Connection
DB_HOST=db
DB_PORT=5432
DB_USERNAME=user
DB_PASSWORD=password
DB_DATABASE=aegis_db

# JWT Secret (CHANGE THIS IN PRODUCTION!)
JWT_SECRET=THIS_IS_A_HARDCODED_SECRET_THAT_WILL_NOT_FAIL

# OpenRouteService API Key (Optional, for routing features)
OPENROUTESERVICE_API_KEY=your_api_key_here